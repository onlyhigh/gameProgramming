}
int left_right_move(void)
{
	int x=3, y=2, temp=2;
	do
	{
		x+=temp;
		if (x>(box_length*2)) //x���� �ִ밪 ����
			temp=-2;
		if (x<3)
		{
			x=3;
			temp=2;
		}

		gotoxy(x, y);
		printf("��");
		Sleep(50); //������ �¿�� �����̴� �ӵ��� ����
		gotoxy(x, y);
		printf("  ");

	}while(!kbhit());
	block_stack[x]+=1;
	return x;
}
void move_down(int x)
{
	int y;
	for(y=2;y<box_height+2-block_stack[x];y+=1)
	{
		gotoxy(x, y);
		printf("��");
		Sleep(20);
		gotoxy(x, y);
		printf("  ");
		Sleep(10);
	}
	gotoxy(x,box_height+2-block_stack[x]);
	printf("��");
}
